{
  "name": "chrome",
  "version": "1.0.0",
  "description": "",
  "main": "background.js",
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "build:ts": "tsc --noEmitOnError",
    "build:copyManifest": "cpy \"./manifest.json\" \"dist\"",
    "build:copyHtmlExcludingDist": "cpy \"./**/*.html\" \"!./dist/**/*.html\" \"dist\" --cwd=.",
    "build:copyImages": "cpy \"./images/**/*\" \"dist/images\" --ignore=dist/**",
    "build:copyCss": "cpy \"./css/**/*\" \"dist/css\" --ignore=dist/**",
    "build:static": "npm run build:copyManifest && npm run build:copyHtmlExcludingDist && npm run build:copyImages && npm run build:copyCss",
    "build": "npm run clean && npm run build:ts && npm run build:static",
    "watch": "tsc -w"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/chrome": "^0.1.32",
    "cpy-cli": "^6.0.0",
    "rimraf": "^6.1.2",
    "typescript": "^5.9.3"
  }
}
